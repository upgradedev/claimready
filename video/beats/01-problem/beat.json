{
  "id": "01-problem",
  "title": "The intake that arrives wrong",
  "kind": "machine",
  "target_seconds": 12,
  "capture": {
    "viewport": {
      "width": 1440,
      "height": 810
    },
    "steps": [
      {
        "do": "goto"
      },
      {
        "do": "wait_text",
        "selector": "[data-el=\"status-text\"]",
        "contains": "No agent detected"
      },
      {
        "do": "wait_text",
        "selector": "[data-el=\"tools-count\"]",
        "contains": "10 tools this page publishes to an agent"
      },
      {
        "do": "wait",
        "ms": 1500
      },
      {
        "do": "scroll_to",
        "selector": "[data-el=\"fields\"]"
      },
      {
        "do": "wait",
        "ms": 3500
      },
      {
        "do": "scroll_to",
        "selector": "[data-el=\"req-summary\"]"
      },
      {
        "do": "wait",
        "ms": 3500
      },
      {
        "do": "scroll_to",
        "selector": "[data-el=\"requirements\"]"
      },
      {
        "do": "wait",
        "ms": 7000
      }
    ]
  }
}
